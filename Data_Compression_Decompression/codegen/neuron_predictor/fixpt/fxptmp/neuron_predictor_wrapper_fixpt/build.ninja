# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /MATLAB
startdir = /MATLAB Drive/Dat_Comp_Decomp/v5/codegen/neuron_predictor/fixpt/fxptmp

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -fvisibility=hidden -std=c99 -I "$root" -I "$matlabdir Drive/Dat_Comp_Decomp/v5/codegen/neuron_predictor/fixpt/fxptmp" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=neuron_predictor_wrapper_fixpt_hdl_mex -DMW_NEEDS_VERSION_H -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -fvisibility=hidden -fno-gnu-unique -std=c++11 -I "$root" -I "$matlabdir Drive/Dat_Comp_Decomp/v5/codegen/neuron_predictor/fixpt/fxptmp" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=neuron_predictor_wrapper_fixpt_hdl_mex -DMW_NEEDS_VERSION_H -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o neuron_predictor_wrapper_fixpt_hdl_mex.mexa64 -Wl,--exclude-libs,ALL -lemlrt -lcovrt -lut -lmwmathutil 

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o neuron_predictor_wrapper_fixpt_hdl_mex.mexa64 -Wl,--exclude-libs,ALL -lemlrt -lcovrt -lut -lmwmathutil 

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/neuron_predictor_wrapper_fixpt_hdl_mex_data.o : cxx $root/neuron_predictor_wrapper_fixpt_hdl_mex_data.cpp
build $builddir/rt_nonfinite.o : cxx $root/rt_nonfinite.cpp
build $builddir/neuron_predictor_wrapper_fixpt_hdl_mex_initialize.o : cxx $root/neuron_predictor_wrapper_fixpt_hdl_mex_initialize.cpp
build $builddir/neuron_predictor_wrapper_fixpt_hdl_mex_terminate.o : cxx $root/neuron_predictor_wrapper_fixpt_hdl_mex_terminate.cpp
build $builddir/neuron_predictor_wrapper_fixpt.o : cxx $root/neuron_predictor_wrapper_fixpt.cpp
build $builddir/neuron_predictor_fixpt_logger.o : cxx $root/neuron_predictor_fixpt_logger.cpp
build $builddir/neuron_predictor_fixpt.o : cxx $root/neuron_predictor_fixpt.cpp
build $builddir/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_api.o : cxx $root/interface/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_api.cpp
build $builddir/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_mex.o : cxx $root/interface/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_mex.cpp
build $builddir/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_info.o : cxx $root/interface/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_info.cpp
build $builddir/cpp_mexapi_version.o : cxx $matlabdir/extern/version/cpp_mexapi_version.cpp

# Link
build $root/neuron_predictor_wrapper_fixpt_hdl_mex.mexa64 : linkxx $builddir/neuron_predictor_wrapper_fixpt_hdl_mex_data.o $builddir/rt_nonfinite.o $builddir/neuron_predictor_wrapper_fixpt_hdl_mex_initialize.o $builddir/neuron_predictor_wrapper_fixpt_hdl_mex_terminate.o $builddir/neuron_predictor_wrapper_fixpt.o $builddir/neuron_predictor_fixpt_logger.o $builddir/neuron_predictor_fixpt.o $builddir/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_api.o $builddir/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_mex.o $builddir/_coder_neuron_predictor_wrapper_fixpt_hdl_mex_info.o $builddir/cpp_mexapi_version.o 
