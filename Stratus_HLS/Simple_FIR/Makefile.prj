	@rm -f $(BDW_WORKLIB)/wrappers/fir_filter_type_wrapper.h
	@rm -f $(BDW_WORKLIB)/wrappers/fir_filter_vlwrapper.v
	@rm -f $(BDW_WORKLIB)/wrappers/fir_filter_cosim.h
	@rm -f $(BDW_WORKLIB)/wrappers/fir_filter_cosim.v
	@rm -f $(BDW_WORKLIB)/wrappers/fir_filter_sc_foreign.h
	@rm -f $(BDW_WORKLIB)/wrappers/bdw_scvector_fir_filter.h 

