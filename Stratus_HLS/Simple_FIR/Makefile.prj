#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fir_filter/config_HLS"
##############################################################

fir_filter_config_HLS_SRCDIR = $(BDW_WORKLIB)/modules/fir_filter/config_HLS
fir_filter_config_HLS_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fir_filter_config_HLS
fir_filter_config_HLS_LIBNAME = fir_filter_config_HLS
fir_filter_config_HLS_WORKLIB = $(BDW_WORKLIB)/modules/fir_filter/config_HLS
fir_filter_config_HLS_C_PARTS_A = $(fir_filter_config_HLS_WORKLIB)/objs/libfir_filter_config_HLS.a

prep_c_fir_filter_config_HLS : $(fir_filter_config_HLS_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fir_filter_config_HLS_WORKLIB) prep_c

prep_c_fir_filter_config_HLS_% : $(fir_filter_config_HLS_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fir_filter_config_HLS_WORKLIB)_$(*F) prep_c

prep_vlog_fir_filter_config_HLS : $(fir_filter_config_HLS_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fir_filter_config_HLS_WORKLIB) prep_vlog

prep_vlog_fir_filter_config_HLS_% : $(fir_filter_config_HLS_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fir_filter_config_HLS_WORKLIB)_$(*F) prep_vlog

prep_fir_filter_config_HLS : $(fir_filter_config_HLS_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fir_filter_config_HLS_WORKLIB) prep

prep_fir_filter_config_HLS_% : $(fir_filter_config_HLS_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fir_filter_config_HLS_WORKLIB)_$(*F) prep

$(fir_filter_config_HLS_WORKLIB)/Makefile : $(fir_filter_config_HLS_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fir_filter_config_HLS_WORKLIB) ]; then mkdir -p $(fir_filter_config_HLS_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(fir_filter_config_HLS_SRCDIR) -o $(fir_filter_config_HLS_WORKLIB)/Makefile -module fir_filter -cynthconfig config_HLS   

$(fir_filter_config_HLS_WORKLIB)_%/Makefile : $(fir_filter_config_HLS_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(fir_filter_config_HLS_WORKLIB)_$(*F) ]; then mkdir -p $(fir_filter_config_HLS_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(fir_filter_config_HLS_SRCDIR)_$(*F) -o $(fir_filter_config_HLS_WORKLIB)_$(*F)/Makefile -module fir_filter -cynthconfig config_HLS_$(*F)   

$(fir_filter_config_HLS_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fir_filter_config_HLS_WORKLIB) ]; then mkdir -p $(fir_filter_config_HLS_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(fir_filter_config_HLS_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(fir_filter_config_HLS_WORKLIB)_$(*F) ]; then mkdir -p $(fir_filter_config_HLS_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fir_filter_config_HLS_WORKLIB)/fir_filter_config_HLS.d :
	@if [ ! -d $(fir_filter_config_HLS_WORKLIB) ]; then mkdir -p $(fir_filter_config_HLS_WORKLIB); fi
	@touch $(fir_filter_config_HLS_WORKLIB)/fir_filter_config_HLS.d



#
# Rules for configured systemModules
#


#
# Per-hls_config rules
#

cynth_config_HLS:  cynth_fir_filter_config_HLS
hlsc_config_HLS:
	@$(MAKE) -j1 update_hierarchy
	@$(MAKE) hlsc_config_HLS


cynthvlg_config_HLS: hls_config_HLS
hls_config_HLS:
	@$(MAKE) -j1 update_hierarchy
	@$(MAKE) hls_config_HLS


cynthvlg_config_HLS: elab_config_HLS
elab_config_HLS:
	@$(MAKE) -j1 update_hierarchy
	@$(MAKE) elab_config_HLS


cynthvlg_config_HLS: optim_config_HLS
optim_config_HLS:
	@$(MAKE) -j1 update_hierarchy
	@$(MAKE) optim_config_HLS


cynthvlg_config_HLS: sched_config_HLS
sched_config_HLS:
	@$(MAKE) -j1 update_hierarchy
	@$(MAKE) sched_config_HLS


view_config_HLS:
	@echo "ERROR: Schematic viewing target 'view_config_HLS' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


clean_config_HLS:
	@rm -f $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp $(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr



##############################################################################
#   start of rules for logic synthesis
##############################################################################

synth1target:
	@echo "NOTE 02926: BEGIN EXTERNAL TOOL PROCESSING"
ifneq ($(PASSED_LOG),)
	rm -f $(PASSED_LOG)
endif
	@if [ ! -d $(BDW_LS_CONFIG_DIR) ]; then mkdir -p $(BDW_LS_CONFIG_DIR); fi
	@rm -rf $(BDW_LS_CONFIG_LOGS)
	@$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_synthinfo.tcl
ifeq ($(BDW_USE_GRID_INT),1)
	@date +"INFO: %D %T ${@} in `pwd` BDW_LS_LIC='${BDW_LS_LIC}' BDW_LS_CMD='${BDW_LS_CMD}' STARTED"
ifeq ($(BDW_LS_LIC),)
	@echo "****** Error: synth1target FAILED because BDW_LS_LIC was not set"; exit 1
endif
endif
	@$(BDW_EXEC_CMD) bdw_exec -jobproject project.tcl -job ls.$(BDW_LS_CONFIG).s $(BDW_LS_CMD)
ifeq ($(BDW_USE_GRID_INT),1)
	@date +"INFO: %D %T ${@} in `pwd` BDW_LS_LIC='${BDW_LS_LIC}' BDW_LS_CMD='${BDW_LS_CMD}' FINISHED"
endif


##############################################################################
#   start of rules for code analysis
##############################################################################

analysis1target:
	@echo "NOTE 02926: BEGIN EXTERNAL TOOL PROCESSING"
