clean_cynth_config_HLS_V_%: clean_hls_config_HLS_V_%

prebuild_config_HLS_V_%: bdw_prebuild_wrappers  
	$(MAKE) -j1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_fir_filter_config_HLS`

prep_config_HLS_V_%: prebuild_config_HLS_V_%
	@$(MAKE) sim_config_HLS_V_$(*F) BDW_XRUN_ELAB=-elaborate

ifeq ($(CWBExec_build),1)

dbg_build_config_HLS_V_%:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=config_HLS_V_$(*F)
	@$(MAKE) BDW_DEBUG=1 build_config_HLS_V_$(*F)


build_config_HLS_V_% build_config_HLS_V_sub_%: 
	@$(MAKE) -j1 update_hierarchy BDW_SIM_CONFIG=config_HLS_V_$(*F) 
	@$(MAKE) build_config_HLS_V_$(*F)

else
.PHONY: build_config_HLS_V
.PHONY: dbg_build_config_HLS_V

dbg_build_config_HLS_V_%:
	@bdw_exec -jobproject project.tcl -job dbg_build.config_HLS_V_$(*F) $(MAKE) CWBExec_build=1 dbg_build_config_HLS_V_$(*F)

build_config_HLS_V_%:
	@bdw_exec -jobproject project.tcl -job build.config_HLS_V_$(*F) $(MAKE) CWBExec_build=1 build_config_HLS_V_$(*F)

build_config_HLS_V_sub_%:
	@bdw_exec -jobproject project.tcl -job build.config_HLS_V_$(*F).s $(MAKE) CWBExec_build=1 build_config_HLS_V_sub_$(*F)
endif


ifeq ($(CWBExec_sim),1)
sim_config_HLS_V_% sim_sub_config_HLS_V_%: build_config_HLS_V_sub_%
	@$(MAKE) run_sim BDW_SIM_CONFIG=config_HLS_V_$(*F)  BDW_BASE_SIM_CONFIG=config_HLS_V BDW_SPEC_NAME=$(*F) 

else
.PHONY: sim_config_HLS_V_%

sim_config_HLS_V_%:
	@bdw_exec -jobproject project.tcl -job sim.config_HLS_V_$(*F) $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_config_HLS_V_$(*F)

sim_sub_config_HLS_V_%:
	@bdw_exec -jobproject project.tcl -job sim_sub.config_HLS_V_$(*F).s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_config_HLS_V_$(*F)
endif


kill_sim_config_HLS_V_%:
	@bdw_kill -job sim.config_HLS_V_$(*F)
	@bdw_kill -job sim.config_HLS_V_$(*F).s


catlog_config_HLS_V_%: catVLGLog_fir_filter_config_HLS
debug_config_HLS_V_%: 
	@$(MAKE) BDW_DEBUG=1 build_config_HLS_V_$(*F)
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=config_HLS_V_$(*F)  BDW_BASE_SIM_CONFIG=config_HLS_V BDW_SPEC_NAME=$(*F) RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_config_HLS_V_%:
	@if [ -e $(BDW_WORKLIB)/sims/config_HLS_V/verilog.vcd ]; then \
	bdw_view_waveform -project project.tcl -simconfig config_HLS_V_$(*F) ;\
	else   \
	$(MAKE) sim_config_HLS_V ;\
	bdw_view_waveform -project project.tcl -simconfig config_HLS_V_$(*F) ;\
    fi
else
view_config_HLS_V_%:
	@bdw_exec -jobproject project.tcl -job view.config_HLS_V_$(*F) $(MAKE) CWBExec_view=1 view_config_HLS_V_$(*F)
endif
    



clean_config_HLS_V_%: clean_hls_config_HLS_V_% clean_sim_config_HLS_V_%

clean_sim_config_HLS_V_%:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.config_HLS_V_$(*F).s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.config_HLS_V_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/build.config_HLS_V_$(*F)
	@rm -f $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.o
	@rm -rf $(BDW_WORKLIB)/sims/config_HLS_V $(BDW_WORKLIB)/sims/config_HLS_V/sim_config_HLS_V.so
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=config_HLS_V_$(*F)  BDW_BASE_SIM_CONFIG=config_HLS_V BDW_SPEC_NAME=$(*F)



$(BDW_WORKLIB)/sims/top_config_HLS_V.v: top_v.bdt $(BDW_LOGOPTIONS_FILE)  $(BDW_VLOG_DUT_FILES)
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig config_HLS_V -top top


#############################################################################
# libesc building rules
#############################################################################

ifeq ($(BDW_DEBUG),1)
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/debug
else
libesc_WORKDIR = $(BDW_WORKLIB)/libesc
endif

BDW_ESC_SOURCES = libesc.o esc_elab.o esc_cleanup.o
BDW_ESC_OBJS = $(addprefix $(libesc_WORKDIR)/, $(BDW_ESC_SOURCES))

$(libesc_WORKDIR)/libesc.a : $(BDW_ESC_OBJS)
	$(BDW_AR) $(libesc_WORKDIR)/libesc.a $(BDW_ESC_OBJS)

${libesc_WORKDIR}/%.o   :   ${STRATUS_HOME}/share/stratus/source/%.cc 
	@if [ ! -d ${libesc_WORKDIR} ]; then mkdir -p ${libesc_WORKDIR}; fi
ifeq ($(BDW_NCSC),1)
	${BDW_CC} " ${BDW_CCFLAGS} ${BDW_COUT}$@ " $<
else
	${BDW_CC} ${BDW_CCFLAGS} ${BDW_COUT}$@ $<
endif



########################################################################
# Rules to prep all libraries
#######################################################################
prep_c_all: $(BDW_C_LIBPREP)

prep_vlog_all: $(BDW_VLOG_LIBPREP)


##############################################################
## Rule for building all Cynth libraries external to the project
##############################################################

build_all_cynthLibs: $(BDW_BOTH_LIBPREP_EXTERNAL)

list_cynthLibs:


##############################################################
## START OF HLS MODULE RULES
##############################################################



##############################################################
## HLS Module "fir_filter"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/fir_filter.d :  fir_filter.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  fir_filter.cpp \
	| sed 's|fir_filter\.o[ :]*|$(BDW_OBJDIR)/fir_filter.o $(BDW_OBJDIR)/fir_filter.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/fir_filter_trace.h : $(BDW_WORKLIB)/wrappers/fir_filter_trace.h.updated

$(BDW_WORKLIB)/wrappers/fir_filter_trace.h.updated :  fir_filter.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fir_filter -vcd 
	@touch $(BDW_WORKLIB)/wrappers/fir_filter_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/fir_filter.o:  fir_filter.cpp $(BDW_WORKLIB)/wrappers/fir_filter_wrap.cpp $(BDW_WORKLIB)/wrappers/fir_filter_wrap.h $(BDW_WORKLIB)/wrappers/fir_filter_cosim.h $(BDW_WORKLIB)/wrappers/fir_filter_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  $(BDW_CCFLAGS)   -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/fir_filter.o  $(BDW_WORKLIB)/wrappers/fir_filter_wrap.cpp

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/debug/fir_filter.o:  fir_filter.cpp $(BDW_WORKLIB)/wrappers/fir_filter_wrap.cpp $(BDW_WORKLIB)/wrappers/fir_filter_wrap.h $(BDW_WORKLIB)/wrappers/fir_filter_cosim.h $(BDW_WORKLIB)/wrappers/fir_filter_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  $(BDW_CCFLAGS)   -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/debug/fir_filter.o  $(BDW_WORKLIB)/wrappers/fir_filter_wrap.cpp

.INTERMEDIATE : fir_filter_wrap.h

fir_filter_wrap.h : $(BDW_WORKLIB)/wrappers/fir_filter_wrap.h

$(BDW_WORKLIB)/wrappers/fir_filter_wrap.cpp $(BDW_WORKLIB)/wrappers/fir_filter_wrap.h $(BDW_WORKLIB)/wrappers/fir_filter_cosim.h $(BDW_WORKLIB)/wrappers/fir_filter_cosim.v   : $(BDW_WRAPDIR)/fir_filter.updated

$(BDW_WRAPDIR)/fir_filter.updated :  fir_filter.cpp 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module fir_filter "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/fir_filter.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module fir_filter -vcd 
	@touch $(BDW_WORKLIB)/wrappers/fir_filter_trace.h.updated
$(BDW_WORKLIB)/wrappers/fir_filter_wrap.d :  fir_filter.cpp $(BDW_WORKLIB)/wrappers/fir_filter_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)   fir_filter.cpp \
		| sed 's|fir_filter\.o[ :]*|$(BDW_WRAPDIR)/fir_filter.updated $(BDW_WORKLIB)/wrappers/fir_filter_wrap.d :  |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/fir_filter_wrap.d 




##############################################################
## HLS Module "fir_filter" - cynthConfigs
##############################################################


#
# HLS config config_HLS
#

#
#	stratus_hls rule
#
LIB_DIRS_fir_filter_config_HLS = 
LIB_INCLUDES_fir_filter_config_HLS = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fir_filter_config_HLS))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fir_filter_config_HLS = 
LIB_NAMES_FOR_VLOG_fir_filter_config_HLS = 
PREFIXED_LIB_NAMES_fir_filter_config_HLS = 
EXTRACT_LIB_DASHI_fir_filter_config_HLS = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fir_filter config_HLS]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fir_filter_config_HLS = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fir_filter/config_HLS/c_parts -Dconfig_HLS=1 -DBDW_RTL_fir_filter_config_HLS=1   $(LIB_INCLUDES_fir_filter_config_HLS)
CCFLAGS_COSIM_fir_filter_config_HLS = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fir_filter/config_HLS/c_parts -Dconfig_HLS=1 -DBDW_RTL_fir_filter_config_HLS=1   $(LIB_INCLUDES_fir_filter_config_HLS)
CCFLAGS_BEH_fir_filter_config_HLS = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fir_filter/config_HLS/c_parts -Dconfig_HLS=1   $(LIB_INCLUDES_fir_filter_config_HLS)
CCFLAGS_fir_filter_config_HLS += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fir_filter_config_HLS += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fir_filter_config_HLS += ${BDW_CCFLAGS_TAIL}

hls_fir_filter_config_HLS : hlsc_fir_filter_config_HLS

cynth_fir_filter_config_HLS : hlsc_fir_filter_config_HLS

elab_fir_filter_config_HLS : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr

optim_fir_filter_config_HLS : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr

sched_fir_filter_config_HLS : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr

.PHONY: hlsc_fir_filter_config_HLS hls_fir_filter_config_HLS

hlsc_fir_filter_config_HLS : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp BDW_DEP_CYNTH_CONFIG=config_HLS BDW_MODULE=fir_filter BDW_HLS_CONFIG=config_HLS
else
	@bdw_exec -jobproject project.tcl -job hls.fir_filter.config_HLS $(MAKE) CWBExec_hls=1 hlsc_fir_filter_config_HLS
endif

clean_cynth_fir_filter_config_HLS: clean_hls_fir_filter_config_HLS

clean_fir_filter_config_HLS: clean_hls_fir_filter_config_HLS

clean_hls_fir_filter_config_HLS:
	@rm -rf $(BDW_WORKLIB)/modules/fir_filter/config_HLS
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fir_filter.config_HLS
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fir_filter.config_HLS.s

kill_hls_fir_filter_config_HLS:
	@bdw_kill -job hls.fir_filter.config_HLS
	@bdw_kill -job hls.fir_filter.config_HLS.s


hls_fir_filter_config_HLS_% : hlsc_fir_filter_config_HLS_%

cynth_fir_filter_config_HLS_% : hlsc_fir_filter_config_HLS_%

elab_fir_filter_config_HLS_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /config_HLS/,/config_HLS_$(*F)/,$(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr)

optim_fir_filter_config_HLS_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /config_HLS/,/config_HLS_$(*F)/,$(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr)

sched_fir_filter_config_HLS_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /config_HLS/,/config_HLS_$(*F)/,$(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr)

.PHONY: hlsc_fir_filter_config_HLS_% hls_fir_filter_config_HLS_%

hlsc_fir_filter_config_HLS_% hls_fir_filter_config_HLS_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /config_HLS/,/config_HLS_$(*F)/,$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp) BDW_DEP_CYNTH_CONFIG=config_HLS BDW_MODULE=fir_filter BDW_HLS_CONFIG=config_HLS_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.fir_filter.config_HLS_$(*F) $(MAKE) CWBExec_hls=1 hlsc_fir_filter_config_HLS_$(*F)
endif

clean_cynth_fir_filter_config_HLS_%: clean_hls_fir_filter_config_HLS_%

clean_fir_filter_config_HLS_%: clean_hls_fir_filter_config_HLS_%

clean_hls_fir_filter_config_HLS_%:
	@rm -rf $(BDW_WORKLIB)/modules/fir_filter/config_HLS_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fir_filter.config_HLS_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fir_filter.config_HLS_$(*F).s

kill_hls_fir_filter_config_HLS_%:
	@bdw_kill -job hls.fir_filter.config_HLS_$(*F)
	@bdw_kill -job hls.fir_filter.config_HLS_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),config_HLS)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
endif


html_fir_filter_config_HLS :
	bdw_htmlgen -project project.tcl -module fir_filter -cynthconfig config_HLS

BDW_fir_filter_config_HLS_HLS_TARGETS = $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.v $(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.bdr
BDW_fir_filter_config_HLS_HLS_SPEC_TARGETS = $(subst /config_HLS/,/config_HLS_%/,$(BDW_fir_filter_config_HLS_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fir_filter_config_HLS_HLS_TARGETS) :  fir_filter.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/fir_filter/config_HLS ]; then mkdir -p $(BDW_WORKLIB)/modules/fir_filter/config_HLS; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=config_HLS BDW_CYNTH_CONFIG=config_HLS \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp \
		BDW_MODULE=fir_filter \
		BDW_CYNTH_CONFIG=config_HLS \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fir_filter/config_HLS \
		BDW_HLS_CONFIG=config_HLS \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fir_filter/config_HLS \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fir_filter_config_HLS) \
		-d $(BDW_WORKLIB)/modules/fir_filter/config_HLS -o fir_filter_rtl.cpp \
		--hls_module=fir_filter --hls_config=config_HLS --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fir_filter_config_HLS))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fir_filter_config_HLS))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fir_filter_config_HLS))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fir_filter_config_HLS) \
		 fir_filter.cpp
	
	
	
	

else

$(BDW_fir_filter_config_HLS_HLS_TARGETS) :  fir_filter.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fir_filter.config_HLS.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_fir_filter_config_HLS_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_trace.h : $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_trace.h.updated

$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_trace.h.updated : $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fir_filter -cynthconfig config_HLS -vcd 
	@touch $(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_fir_filter_config_HLS_HLS_SPEC_TARGETS) :  fir_filter.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/fir_filter/config_HLS_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/fir_filter/config_HLS_$(*F); fi
	
	$(subst /config_HLS ,/config_HLS_$(*F) ,$(subst =config_HLS ,=config_HLS_$(*F) ,$(subst /fir_filter/config_HLS/,/fir_filter/config_HLS_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=config_HLS BDW_CYNTH_CONFIG=config_HLS \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp \
		BDW_MODULE=fir_filter \
		BDW_CYNTH_CONFIG=config_HLS \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fir_filter/config_HLS \
		BDW_HLS_CONFIG=config_HLS \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fir_filter/config_HLS \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fir_filter_config_HLS) \
		`cat  $(BDW_SPECLIB)/fir_filter/config_HLS.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/fir_filter/config_HLS -o fir_filter_rtl.cpp \
		--hls_module=fir_filter --hls_config=config_HLS --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fir_filter_config_HLS))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fir_filter_config_HLS))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fir_filter_config_HLS))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fir_filter_config_HLS) \
		 fir_filter.cpp)))
	
	
	
	

else

$(BDW_fir_filter_config_HLS_HLS_SPEC_TARGETS) :  fir_filter.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fir_filter.config_HLS_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_fir_filter_config_HLS_HLS_SPEC_TARGETS))

endif

	

$(subst /config_HLS/,/config_HLS_%/,$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_trace.h) : $(subst /config_HLS/,/config_HLS_%/,$(BDW_WORKLIB)/modules/fir_filter/config_HLS/fir_filter_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fir_filter -cynthconfig config_HLS_$(*F) -vcd 

catHLLog_fir_filter_config_HLS:
	cat $(BDW_WORKLIB)/modules/fir_filter/config_HLS/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_fir_filter_config_HLS : hls_fir_filter_config_HLS 


.PHONY: hls_fir_filter_config_HLS

hls_fir_filter_config_HLS hlsv_fir_filter_config_HLS: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_fir_filter_config_HLS)) 
ifeq ($(CWBExec_hlsv),1)
	@$(MAKE)  prep_vlog_fir_filter_config_HLS BDW_DEP_CYNTH_CONFIG=config_HLS
else
	@bdw_exec -jobproject project.tcl -job hlsv.fir_filter.config_HLS $(MAKE) CWBExec_hlsv=1 hlsv_fir_filter_config_HLS
endif

