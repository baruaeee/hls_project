.PHONY: hlsc_neuron_fixpt_PIPE_% hls_neuron_fixpt_PIPE_%

hlsc_neuron_fixpt_PIPE_% hls_neuron_fixpt_PIPE_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE/,/PIPE_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc) BDW_DEP_CYNTH_CONFIG=PIPE BDW_MODULE=neuron_fixpt BDW_HLS_CONFIG=PIPE_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIPE_$(*F) $(MAKE) CWBExec_hls=1 hlsc_neuron_fixpt_PIPE_$(*F)
endif

clean_cynth_neuron_fixpt_PIPE_%: clean_hls_neuron_fixpt_PIPE_%

clean_neuron_fixpt_PIPE_%: clean_hls_neuron_fixpt_PIPE_%

clean_hls_neuron_fixpt_PIPE_%:
	@rm -rf $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.PIPE_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.PIPE_$(*F).s

kill_hls_neuron_fixpt_PIPE_%:
	@bdw_kill -job hls.neuron_fixpt.PIPE_$(*F)
	@bdw_kill -job hls.neuron_fixpt.PIPE_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_neuron_fixpt_PIPE :
	bdw_htmlgen -project project.tcl -module neuron_fixpt -cynthconfig PIPE

BDW_neuron_fixpt_PIPE_HLS_TARGETS = $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.v $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/stratus_hls.bdr
BDW_neuron_fixpt_PIPE_HLS_SPEC_TARGETS = $(subst /PIPE/,/PIPE_%/,$(BDW_neuron_fixpt_PIPE_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_PIPE_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE BDW_CYNTH_CONFIG=PIPE \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=PIPE \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE \
		BDW_HLS_CONFIG=PIPE \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_PIPE) \
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=PIPE --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_PIPE))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_PIPE))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_PIPE))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_PIPE) \
		 neuron_fixpt.cc
	
	
	
	

else

$(BDW_neuron_fixpt_PIPE_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIPE.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_neuron_fixpt_PIPE_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_trace.h : $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_trace.h.updated

$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_trace.h.updated : $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt -cynthconfig PIPE  
	@touch $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_PIPE_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE_$(*F); fi
	
	$(subst /PIPE ,/PIPE_$(*F) ,$(subst =PIPE ,=PIPE_$(*F) ,$(subst /neuron_fixpt/PIPE/,/neuron_fixpt/PIPE_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE BDW_CYNTH_CONFIG=PIPE \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=PIPE \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE \
		BDW_HLS_CONFIG=PIPE \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_PIPE) \
		`cat  $(BDW_SPECLIB)/neuron_fixpt/PIPE.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=PIPE --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_PIPE))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_PIPE))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_PIPE))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_PIPE) \
		 neuron_fixpt.cc)))
	
	
	
	

else

$(BDW_neuron_fixpt_PIPE_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIPE_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_neuron_fixpt_PIPE_HLS_SPEC_TARGETS))

endif

	

$(subst /PIPE/,/PIPE_%/,$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_trace.h) : $(subst /PIPE/,/PIPE_%/,$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt -cynthconfig PIPE_$(*F)  

catHLLog_neuron_fixpt_PIPE:
	cat $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/stratus_hls.log

