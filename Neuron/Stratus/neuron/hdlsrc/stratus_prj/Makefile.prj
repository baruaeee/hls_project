	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/ -I./ $(CCFLAGS_neuron_fixpt_FAST) $(EXTRACT_LIB_DASHI_neuron_fixpt_FAST) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/xcelium/neuron_fixpt_rtl.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

