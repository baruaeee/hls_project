	@bdw_kill -job hls.neuron_fixpt.SLOW_$(*F)
	@bdw_kill -job hls.neuron_fixpt.SLOW_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),SLOW)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_neuron_fixpt_SLOW :
	bdw_htmlgen -project project.tcl -module neuron_fixpt -cynthconfig SLOW

BDW_neuron_fixpt_SLOW_HLS_TARGETS = $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.v $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/stratus_hls.bdr
BDW_neuron_fixpt_SLOW_HLS_SPEC_TARGETS = $(subst /SLOW/,/SLOW_%/,$(BDW_neuron_fixpt_SLOW_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_SLOW_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=SLOW BDW_CYNTH_CONFIG=SLOW \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=SLOW \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW \
		BDW_HLS_CONFIG=SLOW \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_SLOW) \
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=SLOW --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_SLOW))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_SLOW))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_SLOW))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_SLOW) \
		 neuron_fixpt.cc
	
	
	
	

else

$(BDW_neuron_fixpt_SLOW_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.SLOW.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_neuron_fixpt_SLOW_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_trace.h : $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_trace.h.updated

$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_trace.h.updated : $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt -cynthconfig SLOW  
	@touch $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_SLOW_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW_$(*F); fi
	
	$(subst /SLOW ,/SLOW_$(*F) ,$(subst =SLOW ,=SLOW_$(*F) ,$(subst /neuron_fixpt/SLOW/,/neuron_fixpt/SLOW_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=SLOW BDW_CYNTH_CONFIG=SLOW \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=SLOW \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW \
		BDW_HLS_CONFIG=SLOW \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_SLOW) \
		`cat  $(BDW_SPECLIB)/neuron_fixpt/SLOW.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=SLOW --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_SLOW))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_SLOW))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_SLOW))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_SLOW) \
		 neuron_fixpt.cc)))
	
	
	
	

else

$(BDW_neuron_fixpt_SLOW_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.SLOW_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_neuron_fixpt_SLOW_HLS_SPEC_TARGETS))

endif

	

$(subst /SLOW/,/SLOW_%/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_trace.h) : $(subst /SLOW/,/SLOW_%/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt -cynthconfig SLOW_$(*F)  

