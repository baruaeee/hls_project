ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc BDW_DEP_CYNTH_CONFIG=PIPE BDW_MODULE=neuron_fixpt BDW_HLS_CONFIG=PIPE
else
	@bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIPE $(MAKE) CWBExec_hls=1 hlsc_neuron_fixpt_PIPE
endif

clean_cynth_neuron_fixpt_PIPE: clean_hls_neuron_fixpt_PIPE

