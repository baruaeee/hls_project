#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt_rtl.o : $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl neuron_fixpt`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/ -I./ $(CCFLAGS_neuron_fixpt_SLOW) $(EXTRACT_LIB_DASHI_neuron_fixpt_SLOW) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt_rtl.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt_rtl.o : $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl neuron_fixpt`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/ -I./ $(CCFLAGS_neuron_fixpt_SLOW) $(EXTRACT_LIB_DASHI_neuron_fixpt_SLOW) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt_rtl.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

