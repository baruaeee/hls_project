#
# Per-hls_config rules
#

cynth_SLOW:  cynth_neuron_fixpt_SLOW
hlsc_SLOW:  
	$(MAKE) -j1 hlsc_neuron_fixpt_SLOW

cynthvlg_SLOW: hls_SLOW
hls_SLOW:  
	$(MAKE) -j1 hls_neuron_fixpt_SLOW

cynthvlg_SLOW: elab_SLOW
elab_SLOW:  
	$(MAKE) -j1 elab_neuron_fixpt_SLOW

cynthvlg_SLOW: optim_SLOW
optim_SLOW:  
	$(MAKE) -j1 optim_neuron_fixpt_SLOW

cynthvlg_SLOW: sched_SLOW
sched_SLOW:  
	$(MAKE) -j1 sched_neuron_fixpt_SLOW

view_SLOW:
	@echo "ERROR: Schematic viewing target 'view_SLOW' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


clean_SLOW:
	@rm -f $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/stratus_hls.bdr


