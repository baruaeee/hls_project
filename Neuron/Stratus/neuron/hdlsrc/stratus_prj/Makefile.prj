	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /SLOW/,/SLOW_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc) BDW_DEP_CYNTH_CONFIG=SLOW BDW_MODULE=neuron_fixpt BDW_HLS_CONFIG=SLOW_$(*F)
