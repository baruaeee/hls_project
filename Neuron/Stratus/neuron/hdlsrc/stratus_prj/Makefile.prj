ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_TLM_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/TLM ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/TLM; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=TLM BDW_CYNTH_CONFIG=TLM \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/neuron_fixpt_rtl.v \
