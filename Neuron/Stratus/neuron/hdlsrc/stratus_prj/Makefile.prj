#########################################################
parentLinks:
	$(warning WARNING: $(BDW_SIM_CONFIG) is a child sim_config of $(BDW_PARENT_SIM).)
	$(warning WARNING: Make sure to run 'make prep_$(BDW_PARENT_SIM)' before running any child sim_configs!)
	@if [ ! -d $(BDW_SIM_CONFIG_DIR) ] ; then mkdir -p $(BDW_SIM_CONFIG_DIR) ; fi
	@cd $(BDW_SIM_CONFIG_DIR) ; \
	ln -sf ../$(BDW_PARENT_SIM)/xcelium ; \
	if [ -d ../$(BDW_PARENT_SIM)/xcelium.d ] ; then \
		ln -sf ../$(BDW_PARENT_SIM)/xcelium.d ; \
	fi; \
	ln -sf ../$(BDW_PARENT_SIM)/siminfo




#########################################################
## Start of the rule set for sim_config BEH
#########################################################



hls_BEH: 



cynth_BEH: 

hls_clean_BEH: clean_hls_BEH

cynth_clean_BEH: hls_clean_BEH

clean_hls_BEH: 
ifneq (,)
	@$(MAKE)  $(addprefix clean_, )
endif

clean_cynth_BEH: clean_hls_BEH

prebuild_BEH: bdw_prebuild_wrappers 

prep_BEH: prebuild_BEH
	@$(MAKE) sim_BEH BDW_XRUN_ELAB=-elaborate

ifeq ($(CWBExec_build),1)

dbg_build_BEH:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=BEH
	@$(MAKE) BDW_DEBUG=1 build_BEH


build_BEH build_BEH_sub: bdw_prebuild_wrappers 
	@$(MAKE) siminfo BDW_SIM_CONFIG=BEH
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=BEH BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME=

else
.PHONY: build_BEH
.PHONY: dbg_build_BEH

dbg_build_BEH:
	@bdw_exec -jobproject project.tcl -job dbg_build.BEH $(MAKE) CWBExec_build=1 dbg_build_BEH

build_BEH:
	@bdw_exec -jobproject project.tcl -job build.BEH $(MAKE) CWBExec_build=1 build_BEH

build_BEH_sub:
	@bdw_exec -jobproject project.tcl -job build.BEH.s $(MAKE) CWBExec_build=1 build_BEH_sub
endif


ifeq ($(CWBExec_sim),1)
sim_BEH sim_sub_BEH: build_BEH_sub
	@$(MAKE) run_sim BDW_SIM_CONFIG=BEH  BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME= 

else
.PHONY: sim_BEH

sim_BEH:
	@bdw_exec -jobproject project.tcl -job sim.BEH $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_BEH

sim_sub_BEH:
	@bdw_exec -jobproject project.tcl -job sim_sub.BEH.s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_BEH
endif


kill_sim_BEH:
	@bdw_kill -job sim.BEH
	@bdw_kill -job sim.BEH.s


catlog_BEH: 
debug_BEH: 
	@$(MAKE) BDW_DEBUG=1 build_BEH
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=BEH  BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME= RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_BEH:
	@if [ -e $(BDW_WORKLIB)/sims/BEH/BEH.shm ]; then \
	bdw_view_waveform -project project.tcl -simconfig BEH ;\
	else   \
	$(MAKE) sim_BEH ;\
	bdw_view_waveform -project project.tcl -simconfig BEH ;\
    fi
else
view_BEH:
	@bdw_exec -jobproject project.tcl -job view.BEH $(MAKE) CWBExec_view=1 view_BEH
endif
    



clean_BEH: clean_hls_BEH clean_sim_BEH

clean_sim_BEH:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BEH.s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BEH
	@rm -rf $(BDW_WORKLIB)/jobs/build.BEH
	@rm -f 
	@rm -rf $(BDW_WORKLIB)/sims/BEH $(BDW_WORKLIB)/sims/BEH/xcelium/sim_BEH
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=BEH  BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME=



clean_wrap_BEH:
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.d
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_sc_wrap.cc
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_sc_wrap.h
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_type_wrapper.cc
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_type_wrapper.h
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_vlwrapper.v
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.v
	@rm -f $(BDW_WORKLIB)/wrappers/neuron_fixpt_sc_foreign.h
	@rm -f $(BDW_WORKLIB)/wrappers/bdw_scvector_neuron_fixpt.h 

hls_BEH_%: 



cynth_BEH_%: 

hls_clean_BEH_%: clean_hls_BEH_%

cynth_clean_BEH_%: hls_clean_BEH_%

clean_hls_BEH_%: 
ifneq (,)
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F)  $(addprefix clean_, )`
endif

clean_cynth_BEH_%: clean_hls_BEH_%

prebuild_BEH_%: bdw_prebuild_wrappers 

prep_BEH_%: prebuild_BEH_%
	@$(MAKE) sim_BEH_$(*F) BDW_XRUN_ELAB=-elaborate

ifeq ($(CWBExec_build),1)

dbg_build_BEH_%:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=BEH_$(*F)
	@$(MAKE) BDW_DEBUG=1 build_BEH_$(*F)


build_BEH_% build_BEH_sub_%: bdw_prebuild_wrappers 
	@$(MAKE) siminfo BDW_SIM_CONFIG=BEH_$(*F)
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=BEH_$(*F) BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME=$(*F)

else
.PHONY: build_BEH
.PHONY: dbg_build_BEH

dbg_build_BEH_%:
	@bdw_exec -jobproject project.tcl -job dbg_build.BEH_$(*F) $(MAKE) CWBExec_build=1 dbg_build_BEH_$(*F)

build_BEH_%:
	@bdw_exec -jobproject project.tcl -job build.BEH_$(*F) $(MAKE) CWBExec_build=1 build_BEH_$(*F)

build_BEH_sub_%:
	@bdw_exec -jobproject project.tcl -job build.BEH_$(*F).s $(MAKE) CWBExec_build=1 build_BEH_sub_$(*F)
endif


ifeq ($(CWBExec_sim),1)
sim_BEH_% sim_sub_BEH_%: build_BEH_sub_%
	@$(MAKE) run_sim BDW_SIM_CONFIG=BEH_$(*F)  BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME=$(*F) 

else
.PHONY: sim_BEH_%

sim_BEH_%:
	@bdw_exec -jobproject project.tcl -job sim.BEH_$(*F) $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_BEH_$(*F)

sim_sub_BEH_%:
	@bdw_exec -jobproject project.tcl -job sim_sub.BEH_$(*F).s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_BEH_$(*F)
endif


kill_sim_BEH_%:
	@bdw_kill -job sim.BEH_$(*F)
	@bdw_kill -job sim.BEH_$(*F).s


catlog_BEH_%: 
debug_BEH_%: 
	@$(MAKE) BDW_DEBUG=1 build_BEH_$(*F)
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=BEH_$(*F)  BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME=$(*F) RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_BEH_%:
	@if [ -e $(BDW_WORKLIB)/sims/BEH/BEH.shm ]; then \
	bdw_view_waveform -project project.tcl -simconfig BEH_$(*F) ;\
	else   \
	$(MAKE) sim_BEH ;\
	bdw_view_waveform -project project.tcl -simconfig BEH_$(*F) ;\
    fi
else
view_BEH_%:
	@bdw_exec -jobproject project.tcl -job view.BEH_$(*F) $(MAKE) CWBExec_view=1 view_BEH_$(*F)
endif
    



clean_BEH_%: clean_hls_BEH_% clean_sim_BEH_%

clean_sim_BEH_%:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BEH_$(*F).s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BEH_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/build.BEH_$(*F)
	@rm -f 
	@rm -rf $(BDW_WORKLIB)/sims/BEH $(BDW_WORKLIB)/sims/BEH/xcelium/sim_BEH
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=BEH_$(*F)  BDW_BASE_SIM_CONFIG=BEH BDW_SPEC_NAME=$(*F)




