#   Rules for power config P_FAST
#
power_P_FAST: BDW_UPF_MODULES      =  neuron_fixpt
power_P_FAST: BDW_PWR_DASH_NETLIST =  0
ifeq ($(CWBExec_pwr),1)
power_P_FAST :
	@$(MAKE) build_V_FAST 
	@$(MAKE) $(BDW_WORKLIB)/sims/V_FAST/V_FAST.shm  
	@if [ ! -d $(BDW_WORKLIB)/power/P_FAST ]; then mkdir -p $(BDW_WORKLIB)/power/P_FAST; fi
	@rm -f $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.rep $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.log $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.bdr
	@BDW_UPF_DATA_FILES="$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_upf.data" $(BDW_EXEC_CMD) bdw_exec -jobproject project.tcl -job power.P_FAST.s  $(BDW_LAUNCH_POWER_COMMAND) bdw_runsjoules $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.info project.tcl P_FAST 2>&1 | tee $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.log 

else
.PHONY: power_P_FAST

power_P_FAST:
	@bdw_exec -jobproject project.tcl -job power.P_FAST $(MAKE) CWBExec_pwr=1 power_P_FAST
endif

kill_power_P_FAST:
	@bdw_kill -job power.P_FAST
	@bdw_kill -job power.P_FAST.s



$(BDW_WORKLIB)/sims/V_FAST/V_FAST.shm: $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.v 
	$(MAKE) sim_V_FAST
    

clean_power_P_FAST:
	@rm -rf $(BDW_WORKLIB)/power/P_FAST
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_FAST
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_FAST.s


power_P_FAST_%: BDW_UPF_MODULES      =  neuron_fixpt
power_P_FAST_%: BDW_PWR_DASH_NETLIST =  0
ifeq ($(CWBExec_pwr),1)
power_P_FAST_% :
	@$(MAKE) build_V_FAST_$(*F) 
	@$(MAKE) $(subst /V_FAST/,/V_FAST_$(*F)/,$(subst /V_FAST.,/V_FAST_$(*F).,$(BDW_WORKLIB)/sims/V_FAST/V_FAST.shm))  
	@if [ ! -d $(BDW_WORKLIB)/power/P_FAST_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/power/P_FAST_$(*F); fi
	@rm -f $(subst /P_FAST/,/P_FAST_$(*F)/,$(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.rep $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.log $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.bdr)
	@BDW_UPF_DATA_FILES="`$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_upf.data`" $(BDW_EXEC_CMD) bdw_exec -jobproject project.tcl -job power.P_FAST_$(*F).s  $(BDW_LAUNCH_POWER_COMMAND) bdw_runsjoules $(subst /P_FAST/,/P_FAST_$(*F)/,$(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.info project.tcl P_FAST_$(*F) 2>&1 | tee $(BDW_WORKLIB)/power/P_FAST/neuron_fixpt.log) 

else
.PHONY: power_P_FAST

power_P_FAST_%:
	@bdw_exec -jobproject project.tcl -job power.P_FAST_$(*F) $(MAKE) CWBExec_pwr=1 power_P_FAST_$(*F)
endif

kill_power_P_FAST_%:
	@bdw_kill -job power.P_FAST_$(*F)
	@bdw_kill -job power.P_FAST_$(*F).s



$(subst /V_FAST/,/V_FAST_%/,$(subst /V_FAST.,/V_FAST_%.,$(BDW_WORKLIB)/sims/V_FAST/V_FAST.shm)):
	$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.v `
	$(MAKE) sim_V_FAST_$(*F)
    

clean_power_P_FAST_%:
	@rm -rf $(BDW_WORKLIB)/power/P_FAST
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_FAST_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_FAST_$(*F).s



