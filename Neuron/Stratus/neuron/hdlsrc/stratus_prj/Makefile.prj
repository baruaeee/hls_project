	$(subst /TLM ,/TLM_$(*F) ,$(subst =TLM ,=TLM_$(*F) ,$(subst /neuron_fixpt/TLM/,/neuron_fixpt/TLM_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=TLM BDW_CYNTH_CONFIG=TLM \
