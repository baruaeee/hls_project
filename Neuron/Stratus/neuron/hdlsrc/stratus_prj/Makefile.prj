#
#	view rule
#

view_neuron_fixpt_PIPE:
	@echo "ERROR: Schematic viewing target 'view_neuron_fixpt_PIPE' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/neuron_fixpt_rtl.o : $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl neuron_fixpt`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/ -I./ $(CCFLAGS_neuron_fixpt_PIPE) $(EXTRACT_LIB_DASHI_neuron_fixpt_PIPE) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/neuron_fixpt_rtl.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/debug/neuron_fixpt_rtl.o : $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl neuron_fixpt`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/ -I./ $(CCFLAGS_neuron_fixpt_PIPE) $(EXTRACT_LIB_DASHI_neuron_fixpt_PIPE) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/debug/neuron_fixpt_rtl.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/neuron_fixpt_beh.o :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE -I./ $(CCFLAGS_BEH_neuron_fixpt_PIPE) -o $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/neuron_fixpt_beh.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/debug/neuron_fixpt_beh.o :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE -I./ $(CCFLAGS_BEH_neuron_fixpt_PIPE) -o $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/debug/neuron_fixpt_beh.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

