#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt.d :  neuron_fixpt.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config FAST of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_neuron_fixpt_FAST)  neuron_fixpt.cc \
	| sed 's|neuron_fixpt\.o[ :]*|$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/xcelium/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/xcelium/debug/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/neuron_fixpt/FAST"
##############################################################

neuron_fixpt_FAST_SRCDIR = $(BDW_WORKLIB)/modules/neuron_fixpt/FAST
neuron_fixpt_FAST_BEH_SRCDIR = $(BDW_WORKLIB)/libs/neuron_fixpt_FAST
neuron_fixpt_FAST_LIBNAME = neuron_fixpt_FAST
neuron_fixpt_FAST_WORKLIB = $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/xcelium
neuron_fixpt_FAST_C_PARTS_A = $(neuron_fixpt_FAST_WORKLIB)/objs/libneuron_fixpt_FAST.a

prep_c_neuron_fixpt_FAST : $(neuron_fixpt_FAST_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_FAST_WORKLIB) prep_c

prep_c_neuron_fixpt_FAST_% : $(neuron_fixpt_FAST_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_FAST_WORKLIB)_$(*F) prep_c

prep_vlog_neuron_fixpt_FAST : $(neuron_fixpt_FAST_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_FAST_WORKLIB) prep_vlog

prep_vlog_neuron_fixpt_FAST_% : $(neuron_fixpt_FAST_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_FAST_WORKLIB)_$(*F) prep_vlog

prep_neuron_fixpt_FAST : $(neuron_fixpt_FAST_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_FAST_WORKLIB) prep

prep_neuron_fixpt_FAST_% : $(neuron_fixpt_FAST_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_FAST_WORKLIB)_$(*F) prep

$(neuron_fixpt_FAST_WORKLIB)/Makefile : $(neuron_fixpt_FAST_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_FAST_WORKLIB) ]; then mkdir -p $(neuron_fixpt_FAST_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_FAST_SRCDIR) -o $(neuron_fixpt_FAST_WORKLIB)/Makefile -module neuron_fixpt -cynthconfig FAST   

$(neuron_fixpt_FAST_WORKLIB)_%/Makefile : $(neuron_fixpt_FAST_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_FAST_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_FAST_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_FAST_SRCDIR)_$(*F) -o $(neuron_fixpt_FAST_WORKLIB)_$(*F)/Makefile -module neuron_fixpt -cynthconfig FAST_$(*F)   

$(neuron_fixpt_FAST_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_FAST_WORKLIB) ]; then mkdir -p $(neuron_fixpt_FAST_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(neuron_fixpt_FAST_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_FAST_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_FAST_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(neuron_fixpt_FAST_WORKLIB)/neuron_fixpt_FAST.d :
	@if [ ! -d $(neuron_fixpt_FAST_WORKLIB) ]; then mkdir -p $(neuron_fixpt_FAST_WORKLIB); fi
	@touch $(neuron_fixpt_FAST_WORKLIB)/neuron_fixpt_FAST.d



#
# HLS config PIPE
#

#
#	stratus_hls rule
#
LIB_DIRS_neuron_fixpt_PIPE = $(memlib_SRCDIR) 
LIB_INCLUDES_neuron_fixpt_PIPE = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_PIPE))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_neuron_fixpt_PIPE = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_neuron_fixpt_PIPE = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_neuron_fixpt_PIPE = 
EXTRACT_LIB_DASHI_neuron_fixpt_PIPE = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl neuron_fixpt PIPE]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_neuron_fixpt_PIPE = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/c_parts -DPIPE=1 -DBDW_RTL_neuron_fixpt_PIPE=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_neuron_fixpt_PIPE)
CCFLAGS_COSIM_neuron_fixpt_PIPE = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/c_parts -DPIPE=1 -DBDW_RTL_neuron_fixpt_PIPE=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_neuron_fixpt_PIPE)
CCFLAGS_BEH_neuron_fixpt_PIPE = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/c_parts -DPIPE=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_neuron_fixpt_PIPE)
CCFLAGS_neuron_fixpt_PIPE += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_neuron_fixpt_PIPE += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_neuron_fixpt_PIPE += ${BDW_CCFLAGS_TAIL}

hls_neuron_fixpt_PIPE : hlsc_neuron_fixpt_PIPE

cynth_neuron_fixpt_PIPE : hlsc_neuron_fixpt_PIPE

elab_neuron_fixpt_PIPE : 
