	@rm -rf $(BDW_WORKLIB)/power/P_SLOW
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_SLOW_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_SLOW_$(*F).s



