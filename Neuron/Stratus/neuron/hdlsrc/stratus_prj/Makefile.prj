$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/neuron_fixpt_hoist.o :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h
