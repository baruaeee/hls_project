#	associated with HLS config names.
#

$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt_beh.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -I./ $(CCFLAGS_BEH_neuron_fixpt_SLOW) -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt_beh.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)

$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt_beh.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -I./ $(CCFLAGS_BEH_neuron_fixpt_SLOW) -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt_beh.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)

#
# Cosim object file rule
#

$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -I./ $(CCFLAGS_COSIM_neuron_fixpt_SLOW) -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)
    

$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt_hoist.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -I./ $(CCFLAGS_neuron_fixpt_SLOW) $(EXTRACT_LIB_DASHI_neuron_fixpt_SLOW) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt_hoist.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)
    

$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -I./ $(CCFLAGS_COSIM_neuron_fixpt_SLOW) -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)


$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt_hoist.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /SLOW/,/SLOW$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW -I./ $(CCFLAGS_neuron_fixpt_SLOW) $(EXTRACT_LIB_DASHI_neuron_fixpt_SLOW) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt_hoist.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt.d :  neuron_fixpt.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config SLOW of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_neuron_fixpt_SLOW)  neuron_fixpt.cc \
	| sed 's|neuron_fixpt\.o[ :]*|$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium/debug/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW"
##############################################################

neuron_fixpt_SLOW_SRCDIR = $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW
neuron_fixpt_SLOW_BEH_SRCDIR = $(BDW_WORKLIB)/libs/neuron_fixpt_SLOW
neuron_fixpt_SLOW_LIBNAME = neuron_fixpt_SLOW
neuron_fixpt_SLOW_WORKLIB = $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/xcelium
neuron_fixpt_SLOW_C_PARTS_A = $(neuron_fixpt_SLOW_WORKLIB)/objs/libneuron_fixpt_SLOW.a

prep_c_neuron_fixpt_SLOW : $(neuron_fixpt_SLOW_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_SLOW_WORKLIB) prep_c

prep_c_neuron_fixpt_SLOW_% : $(neuron_fixpt_SLOW_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_SLOW_WORKLIB)_$(*F) prep_c

prep_vlog_neuron_fixpt_SLOW : $(neuron_fixpt_SLOW_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_SLOW_WORKLIB) prep_vlog

prep_vlog_neuron_fixpt_SLOW_% : $(neuron_fixpt_SLOW_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_SLOW_WORKLIB)_$(*F) prep_vlog

prep_neuron_fixpt_SLOW : $(neuron_fixpt_SLOW_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_SLOW_WORKLIB) prep

prep_neuron_fixpt_SLOW_% : $(neuron_fixpt_SLOW_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_SLOW_WORKLIB)_$(*F) prep

$(neuron_fixpt_SLOW_WORKLIB)/Makefile : $(neuron_fixpt_SLOW_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_SLOW_WORKLIB) ]; then mkdir -p $(neuron_fixpt_SLOW_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_SLOW_SRCDIR) -o $(neuron_fixpt_SLOW_WORKLIB)/Makefile -module neuron_fixpt -cynthconfig SLOW   

$(neuron_fixpt_SLOW_WORKLIB)_%/Makefile : $(neuron_fixpt_SLOW_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_SLOW_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_SLOW_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_SLOW_SRCDIR)_$(*F) -o $(neuron_fixpt_SLOW_WORKLIB)_$(*F)/Makefile -module neuron_fixpt -cynthconfig SLOW_$(*F)   

$(neuron_fixpt_SLOW_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_SLOW_WORKLIB) ]; then mkdir -p $(neuron_fixpt_SLOW_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(neuron_fixpt_SLOW_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_SLOW_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_SLOW_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(neuron_fixpt_SLOW_WORKLIB)/neuron_fixpt_SLOW.d :
	@if [ ! -d $(neuron_fixpt_SLOW_WORKLIB) ]; then mkdir -p $(neuron_fixpt_SLOW_WORKLIB); fi
	@touch $(neuron_fixpt_SLOW_WORKLIB)/neuron_fixpt_SLOW.d



#
# HLS config FAST
#

#
#	stratus_hls rule
#
LIB_DIRS_neuron_fixpt_FAST = $(memlib_SRCDIR) 
LIB_INCLUDES_neuron_fixpt_FAST = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_FAST))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_neuron_fixpt_FAST = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_neuron_fixpt_FAST = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_neuron_fixpt_FAST = 
EXTRACT_LIB_DASHI_neuron_fixpt_FAST = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl neuron_fixpt FAST]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_neuron_fixpt_FAST = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/c_parts -DFAST=1 -DBDW_RTL_neuron_fixpt_FAST=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_neuron_fixpt_FAST)
CCFLAGS_COSIM_neuron_fixpt_FAST = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/c_parts -DFAST=1 -DBDW_RTL_neuron_fixpt_FAST=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_neuron_fixpt_FAST)
CCFLAGS_BEH_neuron_fixpt_FAST = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/c_parts -DFAST=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_neuron_fixpt_FAST)
CCFLAGS_neuron_fixpt_FAST += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_neuron_fixpt_FAST += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_neuron_fixpt_FAST += ${BDW_CCFLAGS_TAIL}

hls_neuron_fixpt_FAST : hlsc_neuron_fixpt_FAST

cynth_neuron_fixpt_FAST : hlsc_neuron_fixpt_FAST

elab_neuron_fixpt_FAST : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.bdr

optim_neuron_fixpt_FAST : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.bdr

sched_neuron_fixpt_FAST : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.bdr

.PHONY: hlsc_neuron_fixpt_FAST hls_neuron_fixpt_FAST

hlsc_neuron_fixpt_FAST : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc BDW_DEP_CYNTH_CONFIG=FAST BDW_MODULE=neuron_fixpt BDW_HLS_CONFIG=FAST
else
	@bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.FAST $(MAKE) CWBExec_hls=1 hlsc_neuron_fixpt_FAST
endif

clean_cynth_neuron_fixpt_FAST: clean_hls_neuron_fixpt_FAST

clean_neuron_fixpt_FAST: clean_hls_neuron_fixpt_FAST

clean_hls_neuron_fixpt_FAST:
	@rm -rf $(BDW_WORKLIB)/modules/neuron_fixpt/FAST
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.FAST
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.FAST.s

kill_hls_neuron_fixpt_FAST:
	@bdw_kill -job hls.neuron_fixpt.FAST
	@bdw_kill -job hls.neuron_fixpt.FAST.s


hls_neuron_fixpt_FAST_% : hlsc_neuron_fixpt_FAST_%

cynth_neuron_fixpt_FAST_% : hlsc_neuron_fixpt_FAST_%

elab_neuron_fixpt_FAST_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /FAST/,/FAST_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.bdr)

optim_neuron_fixpt_FAST_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /FAST/,/FAST_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.bdr)

sched_neuron_fixpt_FAST_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /FAST/,/FAST_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.bdr)

.PHONY: hlsc_neuron_fixpt_FAST_% hls_neuron_fixpt_FAST_%

hlsc_neuron_fixpt_FAST_% hls_neuron_fixpt_FAST_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /FAST/,/FAST_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc) BDW_DEP_CYNTH_CONFIG=FAST BDW_MODULE=neuron_fixpt BDW_HLS_CONFIG=FAST_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.FAST_$(*F) $(MAKE) CWBExec_hls=1 hlsc_neuron_fixpt_FAST_$(*F)
endif

clean_cynth_neuron_fixpt_FAST_%: clean_hls_neuron_fixpt_FAST_%

clean_neuron_fixpt_FAST_%: clean_hls_neuron_fixpt_FAST_%

clean_hls_neuron_fixpt_FAST_%:
	@rm -rf $(BDW_WORKLIB)/modules/neuron_fixpt/FAST_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.FAST_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.FAST_$(*F).s

kill_hls_neuron_fixpt_FAST_%:
	@bdw_kill -job hls.neuron_fixpt.FAST_$(*F)
	@bdw_kill -job hls.neuron_fixpt.FAST_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),FAST)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_neuron_fixpt_FAST :
	bdw_htmlgen -project project.tcl -module neuron_fixpt -cynthconfig FAST

BDW_neuron_fixpt_FAST_HLS_TARGETS = $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.v $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.bdr
BDW_neuron_fixpt_FAST_HLS_SPEC_TARGETS = $(subst /FAST/,/FAST_%/,$(BDW_neuron_fixpt_FAST_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_FAST_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/FAST ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/FAST; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=FAST BDW_CYNTH_CONFIG=FAST \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=FAST \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST \
		BDW_HLS_CONFIG=FAST \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_FAST) \
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/FAST -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=FAST --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_FAST))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_FAST))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_FAST))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_FAST) \
		 neuron_fixpt.cc
	
	
	
	

else

$(BDW_neuron_fixpt_FAST_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.FAST.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_neuron_fixpt_FAST_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_trace.h : $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_trace.h.updated

$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_trace.h.updated : $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt -cynthconfig FAST  
	@touch $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_FAST_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/FAST_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/FAST_$(*F); fi
	
	$(subst /FAST ,/FAST_$(*F) ,$(subst =FAST ,=FAST_$(*F) ,$(subst /neuron_fixpt/FAST/,/neuron_fixpt/FAST_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=FAST BDW_CYNTH_CONFIG=FAST \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=FAST \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST \
		BDW_HLS_CONFIG=FAST \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/FAST \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_FAST) \
		`cat  $(BDW_SPECLIB)/neuron_fixpt/FAST.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/FAST -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=FAST --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_FAST))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_FAST))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_FAST))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_FAST) \
		 neuron_fixpt.cc)))
	
	
	
	

else

$(BDW_neuron_fixpt_FAST_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.FAST_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_neuron_fixpt_FAST_HLS_SPEC_TARGETS))

endif

	

$(subst /FAST/,/FAST_%/,$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_trace.h) : $(subst /FAST/,/FAST_%/,$(BDW_WORKLIB)/modules/neuron_fixpt/FAST/neuron_fixpt_rtl.cc) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt -cynthconfig FAST_$(*F)  

catHLLog_neuron_fixpt_FAST:
	cat $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_neuron_fixpt_FAST : hls_neuron_fixpt_FAST 


.PHONY: hls_neuron_fixpt_FAST

hls_neuron_fixpt_FAST hlsv_neuron_fixpt_FAST: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_neuron_fixpt_FAST)) 
ifeq ($(CWBExec_hlsv),1)
	@$(MAKE)  prep_vlog_neuron_fixpt_FAST BDW_DEP_CYNTH_CONFIG=FAST
else
	@bdw_exec -jobproject project.tcl -job hlsv.neuron_fixpt.FAST $(MAKE) CWBExec_hlsv=1 hlsv_neuron_fixpt_FAST
endif

.PHONY: hls_neuron_fixpt_FAST

hls_neuron_fixpt_FAST_% hlsv_neuron_fixpt_FAST_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_neuron_fixpt_FAST)) 
ifeq ($(CWBExec_hlsv),1)
	@$(MAKE)  prep_vlog_neuron_fixpt_FAST BDW_DEP_CYNTH_CONFIG=FAST
else
	@bdw_exec -jobproject project.tcl -job hlsv.neuron_fixpt.FAST_$(*F) $(MAKE) CWBExec_hlsv=1 hlsv_neuron_fixpt_FAST_$(*F)
endif

catVLGLog_neuron_fixpt_FAST : catHLLog_neuron_fixpt_FAST
	cat $(BDW_WORKLIB)/modules/neuron_fixpt/FAST/stratus_vlg.log

#
#	view rule
#

view_neuron_fixpt_FAST:
	@echo "ERROR: Schematic viewing target 'view_neuron_fixpt_FAST' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


