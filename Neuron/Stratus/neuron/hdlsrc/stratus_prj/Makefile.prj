	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.PIPE.s

kill_hls_neuron_fixpt_PIPE:
	@bdw_kill -job hls.neuron_fixpt.PIPE
	@bdw_kill -job hls.neuron_fixpt.PIPE.s


