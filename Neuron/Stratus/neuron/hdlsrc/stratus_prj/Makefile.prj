## Include pre-defined variables and rules provided with BDW
######################################################################

include ${STRATUS_HOME}/share/stratus/source/bdw.mak

######################################################################
## Error checking rules for variable and environment settings.
######################################################################
vista_needs_gcc3:
ifeq ($(BDW_GCC_VERSION),2.95.3)
	@echo "*** You must use GCC 3 to use Vista." ;  exit
endif

#########################################################
## Start of the "ALL" rule set
#########################################################

pnr_all:


kill_pnr_all:


clean_pnr_all:


power_all: power_P_SLOW power_P_FAST power_P_PIPE


kill_power_all: kill_power_P_SLOW kill_power_P_FAST kill_power_P_PIPE


clean_power_all: clean_power_P_SLOW clean_power_P_FAST clean_power_P_PIPE


equiv_all:


kill_equiv_all:


clean_equiv_all:


ls_all: ls_G_SLOW ls_G_FAST ls_G_PIPE


kill_ls_all: kill_ls_G_SLOW kill_ls_G_FAST kill_ls_G_PIPE


clean_ls_all: clean_ls_G_SLOW clean_ls_G_FAST clean_ls_G_PIPE


analysis_all:


kill_analysis_all:


clean_analysis_all:


hls_sim_all: hls_BEH hls_BEH_TLM hls_BEH_PIN hls_V_SLOW hls_V_FAST hls_V_PIPE


cov_all:


kill_cov_all:


clean_cov_all:


hls_all: hls_neuron_fixpt_SLOW hls_neuron_fixpt_FAST hls_neuron_fixpt_PIPE


hls_neuron_fixpt_all: hls_neuron_fixpt_SLOW hls_neuron_fixpt_FAST hls_neuron_fixpt_PIPE


cynth_all: cynth_BEH cynth_BEH_TLM cynth_BEH_PIN cynth_V_SLOW cynth_V_FAST cynth_V_PIPE


kill_hls_all kill_cynth_all: kill_hls_neuron_fixpt_TLM kill_hls_neuron_fixpt_PIN kill_hls_neuron_fixpt_SLOW kill_hls_neuron_fixpt_FAST kill_hls_neuron_fixpt_PIPE


gen_all_deps: 
ifneq ($(BDW_DEP_FILES),)
	-@$(MAKE) $(BDW_DEP_FILES)
endif


.PHONY: gen_all_deps
.PHONY: all_deps


all_wrappers : bdw_prebuild_wrappers

bdw_prebuild_wrappers: 
ifneq ($(BDW_ALL_WRAPPERS),)
	@$(MAKE) -j 1 $(BDW_ALL_WRAPPERS)
endif

bdw_prebuild_rtl:
ifneq ($(SIM_RTL_TARGETS),)
ifneq ($(BDW_SPEC_NAME),)
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(BDW_SPEC_ARG) $(SIM_RTL_TARGETS)`
else
	@$(MAKE) $(SIM_RTL_TARGETS)
endif
endif

.PHONY: bdw_prebuild_sim_objs

bdw_prebuild_sim_objs:
ifneq ($(SIM_OBJS),)
ifneq ($(BDW_SPEC_NAME),)
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(BDW_SPEC_ARG) $(SIM_OBJS)`
else
	@$(MAKE) $(SIM_OBJS)
endif
endif


clean_hls_all: clean_hls_BEH clean_hls_BEH_TLM clean_hls_BEH_PIN clean_hls_V_SLOW clean_hls_V_FAST clean_hls_V_PIPE

hls_clean_all: clean_hls_all
cynth_clean_all: clean_hls_all
clean_cynth_all: clean_hls_all
prebuild_all: prebuild_BEH prebuild_BEH_TLM prebuild_BEH_PIN prebuild_V_SLOW prebuild_V_FAST prebuild_V_PIPE

build_all: build_BEH build_BEH_TLM build_BEH_PIN build_V_SLOW build_V_FAST build_V_PIPE

sim_all: sim_BEH sim_BEH_TLM sim_BEH_PIN sim_V_SLOW sim_V_FAST sim_V_PIPE

kill_sim_all: kill_sim_BEH kill_sim_BEH_TLM kill_sim_BEH_PIN kill_sim_V_SLOW kill_sim_V_FAST kill_sim_V_PIPE

clean_wrap_all:
	@rm -fr $(BDW_WORKLIB)/wrappers

clean_spec_%:
	@$(BDW_SPEC_CLEAN) $(*F) -prefix

delete_spec_%:
	@$(BDW_SPEC_DELETE) $(*F) -prefix

kill_all: 
	@bdw_kill -all


clean_cachelib:
	@rm -rf /mnt/windows_share/GitRepo/HLS_Thesis/Neuron/Stratus/neuron/hdlsrc/stratus_prj/cachelib

clean_all:
	@if [ -d $(BDW_WORKLIB) ] ; then \
		td=`mktemp -d $(BDW_WORKLIB).XXXXXXXX` ; \
		mv $(BDW_WORKLIB) $${td} ; \
		for f in *.vcd *.fsdb ; do \
			if [ -f $$f ] ; then \
				mv $$f $${td} ; \
			fi ; \
		done ; \
		rm -rf $${td} & \
	fi

clean_sim_all: clean_BEH clean_BEH_TLM clean_BEH_PIN clean_V_SLOW clean_V_FAST clean_V_PIPE clean_deps
	@rm -rf *.vcd *.fsdb $(BDW_OBJDIR) $(BDW_SIMDIR) $(BDW_MODULEDIR) $(BDW_WRAPDIR)

jobs:
	@bdw_ps

clean_libs:
	@rm -rf $(BDW_LIBDIR)

clean_deps:
	@if [ -d $(BDW_WORKLIB) ]; then find $(BDW_WORKLIB) -type f -name '*.d' -exec rm {} \; ; fi

deps : $(DEP_FILES)

