#
#   Rules for power config P_SLOW
#
power_P_SLOW: BDW_UPF_MODULES      =  neuron_fixpt
power_P_SLOW: BDW_PWR_DASH_NETLIST =  0
ifeq ($(CWBExec_pwr),1)
power_P_SLOW :
	@$(MAKE) build_V_SLOW 
	@$(MAKE) $(BDW_WORKLIB)/sims/V_SLOW/V_SLOW.shm  
	@if [ ! -d $(BDW_WORKLIB)/power/P_SLOW ]; then mkdir -p $(BDW_WORKLIB)/power/P_SLOW; fi
	@rm -f $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.rep $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.log $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.bdr
	@BDW_UPF_DATA_FILES="$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_upf.data" $(BDW_EXEC_CMD) bdw_exec -jobproject project.tcl -job power.P_SLOW.s  $(BDW_LAUNCH_POWER_COMMAND) bdw_runsjoules $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.info project.tcl P_SLOW 2>&1 | tee $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.log 

else
.PHONY: power_P_SLOW

power_P_SLOW:
	@bdw_exec -jobproject project.tcl -job power.P_SLOW $(MAKE) CWBExec_pwr=1 power_P_SLOW
endif

kill_power_P_SLOW:
	@bdw_kill -job power.P_SLOW
	@bdw_kill -job power.P_SLOW.s



$(BDW_WORKLIB)/sims/V_SLOW/V_SLOW.shm: $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.v 
	$(MAKE) sim_V_SLOW
    

clean_power_P_SLOW:
	@rm -rf $(BDW_WORKLIB)/power/P_SLOW
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_SLOW
	@rm -rf $(BDW_WORKLIB)/jobs/power.P_SLOW.s


power_P_SLOW_%: BDW_UPF_MODULES      =  neuron_fixpt
power_P_SLOW_%: BDW_PWR_DASH_NETLIST =  0
ifeq ($(CWBExec_pwr),1)
power_P_SLOW_% :
	@$(MAKE) build_V_SLOW_$(*F) 
	@$(MAKE) $(subst /V_SLOW/,/V_SLOW_$(*F)/,$(subst /V_SLOW.,/V_SLOW_$(*F).,$(BDW_WORKLIB)/sims/V_SLOW/V_SLOW.shm))  
	@if [ ! -d $(BDW_WORKLIB)/power/P_SLOW_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/power/P_SLOW_$(*F); fi
	@rm -f $(subst /P_SLOW/,/P_SLOW_$(*F)/,$(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.rep $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.log $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.bdr)
	@BDW_UPF_DATA_FILES="`$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_upf.data`" $(BDW_EXEC_CMD) bdw_exec -jobproject project.tcl -job power.P_SLOW_$(*F).s  $(BDW_LAUNCH_POWER_COMMAND) bdw_runsjoules $(subst /P_SLOW/,/P_SLOW_$(*F)/,$(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.info project.tcl P_SLOW_$(*F) 2>&1 | tee $(BDW_WORKLIB)/power/P_SLOW/neuron_fixpt.log) 

else
.PHONY: power_P_SLOW

power_P_SLOW_%:
	@bdw_exec -jobproject project.tcl -job power.P_SLOW_$(*F) $(MAKE) CWBExec_pwr=1 power_P_SLOW_$(*F)
endif

kill_power_P_SLOW_%:
	@bdw_kill -job power.P_SLOW_$(*F)
	@bdw_kill -job power.P_SLOW_$(*F).s



$(subst /V_SLOW/,/V_SLOW_%/,$(subst /V_SLOW.,/V_SLOW_%.,$(BDW_WORKLIB)/sims/V_SLOW/V_SLOW.shm)):
	$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/neuron_fixpt_rtl.v `
	$(MAKE) sim_V_SLOW_$(*F)
    

