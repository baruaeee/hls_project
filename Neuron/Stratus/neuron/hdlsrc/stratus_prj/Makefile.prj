	@$(MAKE)  $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl neuron_fixpt`
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/ -I./ $(CCFLAGS_neuron_fixpt_TLM) $(EXTRACT_LIB_DASHI_neuron_fixpt_TLM) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt_rtl.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)

$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt_rtl.o) : $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/neuron_fixpt_rtl.cc) $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl neuron_fixpt`
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/ -I./ $(CCFLAGS_neuron_fixpt_TLM) $(EXTRACT_LIB_DASHI_neuron_fixpt_TLM) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt_rtl.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt_beh.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM -I./ $(CCFLAGS_BEH_neuron_fixpt_TLM) -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt_beh.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)

$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt_beh.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM -I./ $(CCFLAGS_BEH_neuron_fixpt_TLM) -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt_beh.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)

#
# Cosim object file rule
#

$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM -I./ $(CCFLAGS_COSIM_neuron_fixpt_TLM) -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)
    

$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt_hoist.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM -I./ $(CCFLAGS_neuron_fixpt_TLM) $(EXTRACT_LIB_DASHI_neuron_fixpt_TLM) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt_hoist.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)
    

$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM -I./ $(CCFLAGS_COSIM_neuron_fixpt_TLM) -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)


$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt_hoist.o) :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /TLM/,/TLM$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/neuron_fixpt/TLM -I./ $(CCFLAGS_neuron_fixpt_TLM) $(EXTRACT_LIB_DASHI_neuron_fixpt_TLM) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt_hoist.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/neuron_fixpt.d :  neuron_fixpt.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config TLM of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_neuron_fixpt_TLM)  neuron_fixpt.cc \
	| sed 's|neuron_fixpt\.o[ :]*|$(BDW_WORKLIB)/modules/neuron_fixpt/TLM/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium/debug/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/neuron_fixpt.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/neuron_fixpt/TLM"
##############################################################

neuron_fixpt_TLM_SRCDIR = $(BDW_WORKLIB)/modules/neuron_fixpt/TLM
neuron_fixpt_TLM_BEH_SRCDIR = $(BDW_WORKLIB)/libs/neuron_fixpt_TLM
neuron_fixpt_TLM_LIBNAME = neuron_fixpt_TLM
neuron_fixpt_TLM_WORKLIB = $(BDW_WORKLIB)/modules/neuron_fixpt/TLM/xcelium
neuron_fixpt_TLM_C_PARTS_A = $(neuron_fixpt_TLM_WORKLIB)/objs/libneuron_fixpt_TLM.a

prep_c_neuron_fixpt_TLM : $(neuron_fixpt_TLM_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_TLM_WORKLIB) prep_c

prep_c_neuron_fixpt_TLM_% : $(neuron_fixpt_TLM_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_TLM_WORKLIB)_$(*F) prep_c

prep_vlog_neuron_fixpt_TLM : $(neuron_fixpt_TLM_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_TLM_WORKLIB) prep_vlog

prep_vlog_neuron_fixpt_TLM_% : $(neuron_fixpt_TLM_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_TLM_WORKLIB)_$(*F) prep_vlog

prep_neuron_fixpt_TLM : $(neuron_fixpt_TLM_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_TLM_WORKLIB) prep

prep_neuron_fixpt_TLM_% : $(neuron_fixpt_TLM_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_TLM_WORKLIB)_$(*F) prep

$(neuron_fixpt_TLM_WORKLIB)/Makefile : $(neuron_fixpt_TLM_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_TLM_WORKLIB) ]; then mkdir -p $(neuron_fixpt_TLM_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_TLM_SRCDIR) -o $(neuron_fixpt_TLM_WORKLIB)/Makefile -module neuron_fixpt -cynthconfig TLM   

$(neuron_fixpt_TLM_WORKLIB)_%/Makefile : $(neuron_fixpt_TLM_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_TLM_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_TLM_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_TLM_SRCDIR)_$(*F) -o $(neuron_fixpt_TLM_WORKLIB)_$(*F)/Makefile -module neuron_fixpt -cynthconfig TLM_$(*F)   

$(neuron_fixpt_TLM_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_TLM_WORKLIB) ]; then mkdir -p $(neuron_fixpt_TLM_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(neuron_fixpt_TLM_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_TLM_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_TLM_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(neuron_fixpt_TLM_WORKLIB)/neuron_fixpt_TLM.d :
	@if [ ! -d $(neuron_fixpt_TLM_WORKLIB) ]; then mkdir -p $(neuron_fixpt_TLM_WORKLIB); fi
	@touch $(neuron_fixpt_TLM_WORKLIB)/neuron_fixpt_TLM.d



#
# HLS config PIN
#

#
#	stratus_hls rule
#
LIB_DIRS_neuron_fixpt_PIN = $(memlib_SRCDIR) 
LIB_INCLUDES_neuron_fixpt_PIN = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_PIN))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_neuron_fixpt_PIN = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_neuron_fixpt_PIN = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_neuron_fixpt_PIN = 
EXTRACT_LIB_DASHI_neuron_fixpt_PIN = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl neuron_fixpt PIN]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_neuron_fixpt_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_neuron_fixpt_PIN)
CCFLAGS_COSIM_neuron_fixpt_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_neuron_fixpt_PIN)
CCFLAGS_BEH_neuron_fixpt_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_neuron_fixpt_PIN)
CCFLAGS_neuron_fixpt_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_neuron_fixpt_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_neuron_fixpt_PIN += ${BDW_CCFLAGS_TAIL}

hls_neuron_fixpt_PIN : hlsc_neuron_fixpt_PIN

cynth_neuron_fixpt_PIN : hlsc_neuron_fixpt_PIN

elab_neuron_fixpt_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/stratus_hls.bdr

optim_neuron_fixpt_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/stratus_hls.bdr

sched_neuron_fixpt_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/stratus_hls.bdr

.PHONY: hlsc_neuron_fixpt_PIN hls_neuron_fixpt_PIN

hlsc_neuron_fixpt_PIN : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.cc BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=neuron_fixpt BDW_HLS_CONFIG=PIN
else
	@bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIN $(MAKE) CWBExec_hls=1 hlsc_neuron_fixpt_PIN
endif

clean_cynth_neuron_fixpt_PIN: clean_hls_neuron_fixpt_PIN

clean_neuron_fixpt_PIN: clean_hls_neuron_fixpt_PIN

clean_hls_neuron_fixpt_PIN:
	@rm -rf $(BDW_WORKLIB)/modules/neuron_fixpt/PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.PIN.s

kill_hls_neuron_fixpt_PIN:
	@bdw_kill -job hls.neuron_fixpt.PIN
	@bdw_kill -job hls.neuron_fixpt.PIN.s


hls_neuron_fixpt_PIN_% : hlsc_neuron_fixpt_PIN_%

cynth_neuron_fixpt_PIN_% : hlsc_neuron_fixpt_PIN_%

elab_neuron_fixpt_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/stratus_hls.bdr)

optim_neuron_fixpt_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/stratus_hls.bdr)

sched_neuron_fixpt_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/stratus_hls.bdr)

.PHONY: hlsc_neuron_fixpt_PIN_% hls_neuron_fixpt_PIN_%

hlsc_neuron_fixpt_PIN_% hls_neuron_fixpt_PIN_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.cc) BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=neuron_fixpt BDW_HLS_CONFIG=PIN_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIN_$(*F) $(MAKE) CWBExec_hls=1 hlsc_neuron_fixpt_PIN_$(*F)
endif

clean_cynth_neuron_fixpt_PIN_%: clean_hls_neuron_fixpt_PIN_%

clean_neuron_fixpt_PIN_%: clean_hls_neuron_fixpt_PIN_%

clean_hls_neuron_fixpt_PIN_%:
	@rm -rf $(BDW_WORKLIB)/modules/neuron_fixpt/PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.neuron_fixpt.PIN_$(*F).s

kill_hls_neuron_fixpt_PIN_%:
	@bdw_kill -job hls.neuron_fixpt.PIN_$(*F)
	@bdw_kill -job hls.neuron_fixpt.PIN_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIN)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_neuron_fixpt_PIN :
	bdw_htmlgen -project project.tcl -module neuron_fixpt -cynthconfig PIN

BDW_neuron_fixpt_PIN_HLS_TARGETS = $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.v $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/stratus_hls.bdr
BDW_neuron_fixpt_PIN_HLS_SPEC_TARGETS = $(subst /PIN/,/PIN_%/,$(BDW_neuron_fixpt_PIN_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_PIN_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/PIN ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/PIN; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_PIN) \
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/PIN -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_PIN) \
		 neuron_fixpt.cc
	
	
	
	

else

$(BDW_neuron_fixpt_PIN_HLS_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIN.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_neuron_fixpt_PIN_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_trace.h : $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_trace.h.updated

$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_trace.h.updated : $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.cc $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt -cynthconfig PIN  
	@touch $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_neuron_fixpt_PIN_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/neuron_fixpt/PIN_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/neuron_fixpt/PIN_$(*F); fi
	
	$(subst /PIN ,/PIN_$(*F) ,$(subst =PIN ,=PIN_$(*F) ,$(subst /neuron_fixpt/PIN/,/neuron_fixpt/PIN_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.cc \
		BDW_MODULE=neuron_fixpt \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_PIN) \
		`cat  $(BDW_SPECLIB)/neuron_fixpt/PIN.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/PIN -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_neuron_fixpt_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_neuron_fixpt_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_neuron_fixpt_PIN) \
		 neuron_fixpt.cc)))
	
	
	
	

else

$(BDW_neuron_fixpt_PIN_HLS_SPEC_TARGETS) :  neuron_fixpt.cc  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.neuron_fixpt.PIN_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_neuron_fixpt_PIN_HLS_SPEC_TARGETS))

