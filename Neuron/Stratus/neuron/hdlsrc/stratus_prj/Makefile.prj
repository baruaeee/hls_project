		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/neuron_fixpt/TLM \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_neuron_fixpt_TLM) \
		-d $(BDW_WORKLIB)/modules/neuron_fixpt/TLM -o neuron_fixpt_rtl.cc \
		--hls_module=neuron_fixpt --hls_config=TLM --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_TLM))) \
