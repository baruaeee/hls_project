#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt.d :  neuron_fixpt.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_neuron_fixpt_PIPE)  neuron_fixpt.cc \
	| sed 's|neuron_fixpt\.o[ :]*|$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium/debug/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/neuron_fixpt.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/neuron_fixpt/PIPE"
##############################################################

neuron_fixpt_PIPE_SRCDIR = $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE
neuron_fixpt_PIPE_BEH_SRCDIR = $(BDW_WORKLIB)/libs/neuron_fixpt_PIPE
neuron_fixpt_PIPE_LIBNAME = neuron_fixpt_PIPE
neuron_fixpt_PIPE_WORKLIB = $(BDW_WORKLIB)/modules/neuron_fixpt/PIPE/xcelium
neuron_fixpt_PIPE_C_PARTS_A = $(neuron_fixpt_PIPE_WORKLIB)/objs/libneuron_fixpt_PIPE.a

prep_c_neuron_fixpt_PIPE : $(neuron_fixpt_PIPE_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIPE_WORKLIB) prep_c

prep_c_neuron_fixpt_PIPE_% : $(neuron_fixpt_PIPE_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIPE_WORKLIB)_$(*F) prep_c

prep_vlog_neuron_fixpt_PIPE : $(neuron_fixpt_PIPE_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIPE_WORKLIB) prep_vlog

prep_vlog_neuron_fixpt_PIPE_% : $(neuron_fixpt_PIPE_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIPE_WORKLIB)_$(*F) prep_vlog

prep_neuron_fixpt_PIPE : $(neuron_fixpt_PIPE_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIPE_WORKLIB) prep

prep_neuron_fixpt_PIPE_% : $(neuron_fixpt_PIPE_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIPE_WORKLIB)_$(*F) prep

$(neuron_fixpt_PIPE_WORKLIB)/Makefile : $(neuron_fixpt_PIPE_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_PIPE_WORKLIB) ]; then mkdir -p $(neuron_fixpt_PIPE_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_PIPE_SRCDIR) -o $(neuron_fixpt_PIPE_WORKLIB)/Makefile -module neuron_fixpt -cynthconfig PIPE   

$(neuron_fixpt_PIPE_WORKLIB)_%/Makefile : $(neuron_fixpt_PIPE_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_PIPE_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_PIPE_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_PIPE_SRCDIR)_$(*F) -o $(neuron_fixpt_PIPE_WORKLIB)_$(*F)/Makefile -module neuron_fixpt -cynthconfig PIPE_$(*F)   

$(neuron_fixpt_PIPE_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_PIPE_WORKLIB) ]; then mkdir -p $(neuron_fixpt_PIPE_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(neuron_fixpt_PIPE_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_PIPE_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_PIPE_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(neuron_fixpt_PIPE_WORKLIB)/neuron_fixpt_PIPE.d :
	@if [ ! -d $(neuron_fixpt_PIPE_WORKLIB) ]; then mkdir -p $(neuron_fixpt_PIPE_WORKLIB); fi
	@touch $(neuron_fixpt_PIPE_WORKLIB)/neuron_fixpt_PIPE.d



#
# Rules for configured systemModules
#


#
#	Behavioral object file rule.  Used only for BEH configs that are
#	associated with system config names.
#

LIB_DIRS_main_TLM = $(memlib_SRCDIR) 
LIB_INCLUDES_main_TLM = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_main_TLM)))
CCFLAGS_main_TLM = -I./ -I$(BDW_WRAPDIR) $(LIB_INCLUDES_main_TLM)   -DioConfig_TLM -D_p_ioConfig_TLM -DioConfig=TLM -D_wrap_ioConfig=TLM  
CCFLAGS_main_TLM += ${BDW_CCFLAGS_TAIL}

$(BDW_WORKLIB)/modules/main/TLM/xcelium/main_beh.o : main.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/main/TLM -I./ $(CCFLAGS_main_TLM) -o $(BDW_WORKLIB)/modules/main/TLM/xcelium/main_beh.o " main.cc

$(BDW_WORKLIB)/modules/main/TLM/xcelium/debug/main_beh.o : main.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/main/TLM -I./ $(CCFLAGS_main_TLM) -o $(BDW_WORKLIB)/modules/main/TLM/xcelium/debug/main_beh.o " main.cc

$(BDW_WORKLIB)/modules/main/TLM/main.d: main.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for system config TLM of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_main_TLM) $< \
	| sed 's|main\.o[ :]*|$(BDW_WORKLIB)/modules/main/TLM/xcelium/main_beh.o $(BDW_WORKLIB)/modules/main/TLM/xcelium/debug/main_beh.o $(BDW_WORKLIB)/modules/main/TLM/main.d : |' $(BDW_DEP_FILTER)  > $@


