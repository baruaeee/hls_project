#############################################################################
# libesc building rules
#############################################################################

ifeq ($(BDW_DEBUG),1)
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/xcelium/debug
else
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/xcelium
endif

BDW_ESC_SOURCES = libesc.o esc_elab.o esc_cleanup.o
BDW_ESC_OBJS = $(addprefix $(libesc_WORKDIR)/, $(BDW_ESC_SOURCES))

$(libesc_WORKDIR)/libesc.a : $(BDW_ESC_OBJS)
	$(BDW_AR) $(libesc_WORKDIR)/libesc.a $(BDW_ESC_OBJS)

${libesc_WORKDIR}/%.o   :   ${STRATUS_HOME}/share/stratus/source/%.cc 
	@if [ ! -d ${libesc_WORKDIR} ]; then mkdir -p ${libesc_WORKDIR}; fi
ifeq ($(BDW_NCSC),1)
	${BDW_CC} " ${BDW_CCFLAGS} ${BDW_COUT}$@ " $<
else
	${BDW_CC} ${BDW_CCFLAGS} ${BDW_COUT}$@ $<
endif




##############################################################
## Parts Library "memlib"
##############################################################

memlib_SRCDIR = memlib
memlib_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memlib
memlib_LIBNAME = memlib
memlib_WORKLIB = $(BDW_WORKLIB)/libs/memlib/xcelium
memlib_C_PARTS_A = $(memlib_WORKLIB)/objs/libmemlib.a

prep_c_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep_c

prep_c_memlib_% : $(memlib_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB)_$(*F) prep_c

prep_vlog_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep_vlog

prep_vlog_memlib_% : $(memlib_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB)_$(*F) prep_vlog

prep_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep

prep_memlib_% : $(memlib_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB)_$(*F) prep

$(memlib_WORKLIB)/Makefile : $(memlib_SRCDIR)/
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen  -scsim xcelium -lib $(memlib_SRCDIR) -o $(memlib_WORKLIB)/Makefile -module  -cynthconfig    -project project.tcl

$(memlib_WORKLIB)_%/Makefile : $(memlib_SRCDIR)_%/
	@if [ ! -d $(memlib_WORKLIB)_$(*F) ]; then mkdir -p $(memlib_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen  -scsim xcelium -lib $(memlib_SRCDIR)_$(*F) -o $(memlib_WORKLIB)_$(*F)/Makefile -module  -cynthconfig _$(*F)   -project project.tcl

$(memlib_SRCDIR)/ :
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(memlib_SRCDIR)_%/ :
	@if [ ! -d $(memlib_WORKLIB)_$(*F) ]; then mkdir -p $(memlib_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



BDW_LIBEXT_memlib=$(shell if test -f $(memlib_SRCDIR)/c_parts/memlib.cc ; then echo "cc"; else echo "cpp"; fi)

$(memlib_WORKLIB)/memlib.d : $(memlib_SRCDIR)/c_parts/memlib.$(BDW_LIBEXT_memlib)
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) $< | sed 's|memlib\.o[ :]*|memlib_DEPS = |' $(BDW_DEP_FILTER) > $@



BDW_C_LIBPREP += prep_c_memlib
BDW_C_LIBREF += $(memlib_WORKLIB)/INCA_libs/memlib_worklib
BDW_VLOG_LIBPREP += prep_vlog_memlib
BDW_BOTH_LIBPREP += prep_memlib


BDW_HLSLIB_DIRS += $(BDW_WORKLIB)/libs/memlib/xcelium
BDW_HLSLIB_NAMES += $(memlib_LIBNAME)


BDW_WHOLELIB_DIRS += $(memlib_SRCDIR)
BDW_WHOLELIB_NAMES += $(memlib_LIBNAME)


########################################################################
# Rules to prep all libraries
#######################################################################
prep_c_all: $(BDW_C_LIBPREP)

prep_vlog_all: $(BDW_VLOG_LIBPREP)


##############################################################
## Rule for building all Cynth libraries external to the project
##############################################################

build_all_cynthLibs: $(BDW_BOTH_LIBPREP_EXTERNAL)

list_cynthLibs:

	@echo /mnt/windows_share/GitRepo/HLS_Thesis/Neuron/Stratus/neuron/hdlsrc/stratus_prj memlib prep_memlib

##############################################################
## START OF HLS MODULE RULES
##############################################################



##############################################################
## HLS Module "neuron_fixpt"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/neuron_fixpt.d :  neuron_fixpt.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  neuron_fixpt.cc \
	| sed 's|neuron_fixpt\.o[ :]*|$(BDW_OBJDIR)/neuron_fixpt.o $(BDW_OBJDIR)/neuron_fixpt.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h : $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h.updated

$(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h.updated :  neuron_fixpt.cc $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt  
	@touch $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/neuron_fixpt.o:  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_TLM -D_p_ioConfig_TLM -DioConfig=TLM -D_wrap_ioConfig=TLM  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/neuron_fixpt.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/neuron_fixpt.o:  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_TLM -D_p_ioConfig_TLM -DioConfig=TLM -D_wrap_ioConfig=TLM  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/neuron_fixpt.o " $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc

.INTERMEDIATE : neuron_fixpt_wrap.h

neuron_fixpt_wrap.h : $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h

$(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.h $(BDW_WORKLIB)/wrappers/neuron_fixpt_cosim.v   : $(BDW_WRAPDIR)/neuron_fixpt.updated

$(BDW_WRAPDIR)/neuron_fixpt.updated :  neuron_fixpt.cc 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module neuron_fixpt "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/neuron_fixpt.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module neuron_fixpt  
	@touch $(BDW_WORKLIB)/wrappers/neuron_fixpt_trace.h.updated
$(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.d :  neuron_fixpt.cc $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) -DioConfig_TLM -D_p_ioConfig_TLM -DioConfig=TLM -D_wrap_ioConfig=TLM  neuron_fixpt.cc \
		| sed 's|neuron_fixpt\.o[ :]*|$(BDW_WRAPDIR)/neuron_fixpt.updated $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.d :  memlib/memlib.bdl |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/neuron_fixpt_wrap.d 




