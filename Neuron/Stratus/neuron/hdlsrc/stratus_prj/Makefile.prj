#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt.d :  neuron_fixpt.cc
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIN of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_neuron_fixpt_PIN)  neuron_fixpt.cc \
	| sed 's|neuron_fixpt\.o[ :]*|$(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt_rtl.cc $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/xcelium/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/xcelium/debug/neuron_fixpt_beh.o $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/neuron_fixpt.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/neuron_fixpt/PIN"
##############################################################

neuron_fixpt_PIN_SRCDIR = $(BDW_WORKLIB)/modules/neuron_fixpt/PIN
neuron_fixpt_PIN_BEH_SRCDIR = $(BDW_WORKLIB)/libs/neuron_fixpt_PIN
neuron_fixpt_PIN_LIBNAME = neuron_fixpt_PIN
neuron_fixpt_PIN_WORKLIB = $(BDW_WORKLIB)/modules/neuron_fixpt/PIN/xcelium
neuron_fixpt_PIN_C_PARTS_A = $(neuron_fixpt_PIN_WORKLIB)/objs/libneuron_fixpt_PIN.a

prep_c_neuron_fixpt_PIN : $(neuron_fixpt_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIN_WORKLIB) prep_c

prep_c_neuron_fixpt_PIN_% : $(neuron_fixpt_PIN_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIN_WORKLIB)_$(*F) prep_c

prep_vlog_neuron_fixpt_PIN : $(neuron_fixpt_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIN_WORKLIB) prep_vlog

prep_vlog_neuron_fixpt_PIN_% : $(neuron_fixpt_PIN_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIN_WORKLIB)_$(*F) prep_vlog

prep_neuron_fixpt_PIN : $(neuron_fixpt_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIN_WORKLIB) prep

prep_neuron_fixpt_PIN_% : $(neuron_fixpt_PIN_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(neuron_fixpt_PIN_WORKLIB)_$(*F) prep

$(neuron_fixpt_PIN_WORKLIB)/Makefile : $(neuron_fixpt_PIN_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_PIN_WORKLIB) ]; then mkdir -p $(neuron_fixpt_PIN_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_PIN_SRCDIR) -o $(neuron_fixpt_PIN_WORKLIB)/Makefile -module neuron_fixpt -cynthconfig PIN   

$(neuron_fixpt_PIN_WORKLIB)_%/Makefile : $(neuron_fixpt_PIN_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(neuron_fixpt_PIN_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_PIN_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(neuron_fixpt_PIN_SRCDIR)_$(*F) -o $(neuron_fixpt_PIN_WORKLIB)_$(*F)/Makefile -module neuron_fixpt -cynthconfig PIN_$(*F)   

$(neuron_fixpt_PIN_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_PIN_WORKLIB) ]; then mkdir -p $(neuron_fixpt_PIN_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(neuron_fixpt_PIN_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(neuron_fixpt_PIN_WORKLIB)_$(*F) ]; then mkdir -p $(neuron_fixpt_PIN_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(neuron_fixpt_PIN_WORKLIB)/neuron_fixpt_PIN.d :
	@if [ ! -d $(neuron_fixpt_PIN_WORKLIB) ]; then mkdir -p $(neuron_fixpt_PIN_WORKLIB); fi
	@touch $(neuron_fixpt_PIN_WORKLIB)/neuron_fixpt_PIN.d



#
# HLS config SLOW
#

#
#	stratus_hls rule
#
LIB_DIRS_neuron_fixpt_SLOW = $(memlib_SRCDIR) 
LIB_INCLUDES_neuron_fixpt_SLOW = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_neuron_fixpt_SLOW))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_neuron_fixpt_SLOW = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_neuron_fixpt_SLOW = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_neuron_fixpt_SLOW = 
EXTRACT_LIB_DASHI_neuron_fixpt_SLOW = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl neuron_fixpt SLOW]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_neuron_fixpt_SLOW = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/c_parts -DSLOW=1 -DBDW_RTL_neuron_fixpt_SLOW=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=1000 $(LIB_INCLUDES_neuron_fixpt_SLOW)
CCFLAGS_COSIM_neuron_fixpt_SLOW = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/c_parts -DSLOW=1 -DBDW_RTL_neuron_fixpt_SLOW=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=1000 $(LIB_INCLUDES_neuron_fixpt_SLOW)
CCFLAGS_BEH_neuron_fixpt_SLOW = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/neuron_fixpt/SLOW/c_parts -DSLOW=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DLAT=1000 $(LIB_INCLUDES_neuron_fixpt_SLOW)
CCFLAGS_neuron_fixpt_SLOW += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_neuron_fixpt_SLOW += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_neuron_fixpt_SLOW += ${BDW_CCFLAGS_TAIL}

